{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf output)",
      "Bash(rm -rf output/*)",
      "Bash(rm -rf .git)",
      "Read(./.env)",
      "Bash(git push:*)"
    ],
    "ask": [
      "Bash(python scripts/run_provision.py:*)",
      "Bash(python scripts/run_submit.py:*)",
      "Bash(python scripts/run_dynamics.py:*)",
      "Bash(python scripts/run_all.py:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/block-prod-environment.sh" },
          { "type": "command", "command": ".claude/hooks/redact-secrets.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/validate-odm.sh" }
        ]
      }
    ]
  },
  "env": {
    "PYTHONDONTWRITEBYTECODE": "1"
  }
}
