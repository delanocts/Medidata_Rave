<?xml version="1.0" encoding="utf-8"?>
<ODM xmlns="http://www.cdisc.org/ns/odm/v1.3"
     xmlns:mdsol="http://www.mdsol.com/ns/odm/metadata" ODMVersion="1.3">
  <Study OID="ALPHA(Dev)">
    <GlobalVariables><StudyName>ALPHA</StudyName><ProtocolName>ALPHA</ProtocolName></GlobalVariables>
    <MetaDataVersion OID="7" Name="Initial" mdsol:PrimaryFormOID="REG" mdsol:DefaultMatrixOID="DEFAULT">

      <StudyEventDef OID="V1" Name="Visit 1" Type="Scheduled" Repeating="No"
                     mdsol:OrderNumber="1">
        <FormRef FormOID="REG" Mandatory="Yes" OrderNumber="1"/>
        <FormRef FormOID="OBS" Mandatory="No" OrderNumber="2"/>
      </StudyEventDef>

      <FormDef OID="REG" Name="Registration" Repeating="No" mdsol:OrderNumber="1">
        <ItemGroupRef ItemGroupOID="REG_G" Mandatory="Yes"/>
      </FormDef>
      <FormDef OID="OBS" Name="Observation" Repeating="No" mdsol:OrderNumber="2">
        <ItemGroupRef ItemGroupOID="OBS_G" Mandatory="No"/>
      </FormDef>

      <ItemGroupDef OID="REG_G" Name="Registration" Repeating="No">
        <ItemRef ItemOID="REG.PID" OrderNumber="1" Mandatory="Yes"/>
        <ItemRef ItemOID="REG.CONSENT" OrderNumber="2" Mandatory="Yes"/>
      </ItemGroupDef>
      <ItemGroupDef OID="OBS_G" Name="Observation" Repeating="No">
        <ItemRef ItemOID="OBS.TEMP" OrderNumber="1" Mandatory="No"/>
        <ItemRef ItemOID="OBS.WHEN" OrderNumber="2" Mandatory="No"/>
      </ItemGroupDef>

      <ItemDef OID="REG.PID" Name="PID" DataType="text" Length="10"
               mdsol:Active="Yes" mdsol:Visible="Yes">
        <Question><TranslatedText xml:lang="en">Participant number</TranslatedText></Question>
      </ItemDef>
      <ItemDef OID="REG.CONSENT" Name="CONSENT" DataType="text" Length="1"
               mdsol:Active="Yes" mdsol:Visible="Yes">
        <Question><TranslatedText xml:lang="en">Consent given</TranslatedText></Question>
        <CodeListRef CodeListOID="YESNO"/>
      </ItemDef>
      <ItemDef OID="OBS.TEMP" Name="TEMP" DataType="float" Length="4"
               SignificantDigits="1" mdsol:Active="Yes" mdsol:Visible="Yes">
        <Question><TranslatedText xml:lang="en">Temperature</TranslatedText></Question>
        <MeasurementUnitRef MeasurementUnitOID="degC"/>
        <RangeCheck Comparator="GE" SoftHard="Soft"><CheckValue>34</CheckValue></RangeCheck>
        <RangeCheck Comparator="LE" SoftHard="Soft"><CheckValue>43</CheckValue></RangeCheck>
      </ItemDef>
      <ItemDef OID="OBS.WHEN" Name="WHEN" DataType="date" mdsol:DateTimeFormat="dd MMM yyyy"
               mdsol:Active="Yes" mdsol:Visible="Yes">
        <Question><TranslatedText xml:lang="en">Observation date</TranslatedText></Question>
      </ItemDef>

      <CodeList OID="YESNO" Name="Yes/No" DataType="text">
        <CodeListItem CodedValue="Y" mdsol:OrderNumber="1">
          <Decode><TranslatedText xml:lang="en">Yes</TranslatedText></Decode>
        </CodeListItem>
        <CodeListItem CodedValue="N" mdsol:OrderNumber="2">
          <Decode><TranslatedText xml:lang="en">No</TranslatedText></Decode>
        </CodeListItem>
      </CodeList>
      <MeasurementUnit OID="degC" Name="degC">
        <Symbol><TranslatedText xml:lang="en">degC</TranslatedText></Symbol>
      </MeasurementUnit>
    </MetaDataVersion>
  </Study>
</ODM>
